{
  "name": "xueke",
  "productName": "学刻",
  "version": "0.1.3",
  "private": true,
  "description": "学刻 — 面向学习场景的 PC 端番茄工作法客户端",
  "author": "Fangfang-Lee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Fangfang-Lee/xueke.git"
  },
  "bugs": {
    "url": "https://github.com/Fangfang-Lee/xueke/issues"
  },
  "homepage": "https://github.com/Fangfang-Lee/xueke#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.fangfanglee.xueke",
    "productName": "学刻",
    "files": ["out/**/*", "package.json"],
    "mac": { "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
